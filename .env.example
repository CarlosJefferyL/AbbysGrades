# Contraseña para entrar a la app. Es una sola para todos los dispositivos.
# Cambiarla cierra las sesiones abiertas en todos los navegadores.
CLAVE_ACCESO=

# Firma la cookie de sesión. Generar con: openssl rand -hex 32
# Se deja vacío a propósito: un valor de relleno invita a copiarlo tal cual.
SECRET_KEY=

# Solo para deploy/docker-compose.prod.yml (servidor dedicado, Caddy con TLS
# propio). El despliegue de Coolify no lo usa: ahí el dominio se asigna desde
# Coolify y Caddy corre en ":80" fijo dentro del compose.
DOMINIO=abbysgrades.ejemplo.mx
