# Etapa de verificación: corre las pruebas de grades.js antes de empaquetar.
# Si una prueba falla, la imagen no se construye y no se despliega una versión
# que calcule mal las calificaciones.
FROM node:22-slim AS pruebas
WORKDIR /app
COPY grades.js ./
COPY test/ ./test/
# Sólo las pruebas del cálculo: las de la API corren en Dockerfile.api.
RUN node --test test/*.test.js

# Imagen final: Caddy sirviendo los archivos estáticos y haciendo proxy de
# /api al servicio `api`. No hay build de frontend (no hay bundler): los
# archivos se copian tal cual.
FROM caddy:2-alpine
COPY --from=pruebas /app/grades.js /srv/grades.js
COPY index.html app.js styles.css /srv/
COPY deploy/Caddyfile /etc/caddy/Caddyfile
